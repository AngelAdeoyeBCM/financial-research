    A010["<div class='arg'><b>A010 · VIEW</b><div class='core view'><span>Markets once again question the Fed's commitment to the 2% inflation target.</span><b>[H]</b></div><div class='c sup'><span><b>P:</b> Warsh attempts a #quot;dovish hike#quot; by reassuring markets that the Fed will proceed cautiously.</span><b>[HY]</b></div></div>"]
    A011["<div class='arg'><b>A011 · FORECAST</b><div class='core fc'><span>The hawkish presser sees 2Y rates rise 5-10bps.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> The market raises the hike peak.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> The market pulls forward hike timing.</span><b>[H]</b></div><div class='c sup'><span><b>CO:</b> Warsh continues to sound inflation impatient.</span><b>[HY]</b></div><div class='c sup'><span><b>CO:</b> Warsh suggests recent data does not imply an adequate disinflation trend.</span><b>[HY]</b></div><div class='c fc'><span><b>IM:</b> The hawkish presser sees 30Y rates lower by 5-10bps.</span><b>[H]</b></div></div>"]
    A012["<div class='arg'><b>A012 · FORECAST</b><div class='core fc'><span>The dovish presser sees 2Y rates lower by 5bps.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> The market reduces the hike peak.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> The market pushes out hike timing.</span><b>[H]</b></div><div class='c sup'><span><b>CO:</b> Warsh implies an unpopular hike.</span><b>[HY]</b></div><div class='c sup'><span><b>CO:</b> Warsh implies few hikes to follow.</span><b>[HY]</b></div><div class='c sup'><span><b>CO:</b> Warsh implies improved signs in the inflation trend.</span><b>[HY]</b></div><div class='c fc'><span><b>IM:</b> The dovish presser sees 30Y rates higher by 5bps.</span><b>[H]</b></div></div>"]
    A013["<div class='arg'><b>A013 · VIEW</b><div class='core view'><span>There is a sharp twist steepening of the curve.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> Twist steepening comes from a lower near term policy path.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> Twist steepening comes from a perceived very high bar to hike.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> <b>A014 - VIEW</b></span></div><div class='c sup'><span><b>CO:</b> The Fed surprisingly holds.</span><b>[HY]</b></div></div>"]
