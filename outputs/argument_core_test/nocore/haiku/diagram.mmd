    A004["<div class='arg'><b>A004 · PREDICTION</b><div class='core pred'><span>Warsh in the presser is more Warsh as at Jackson Hole than Warsh as at the July FOMC.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> Warsh's Jackson Hole-style presser is largely to support the bond.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> The Warsh Jackson Hole speech was more transparent about Warsh's outlook.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> The Warsh Jackson Hole speech was more transparent about Warsh's reaction function.</span><b>[A]</b></div></div>"]
    A005["<div class='arg'><b>A005 · PREDICTION</b><div class='core pred'><span>Warsh delivers a hawkish hike.</span><b>[H]</b></div><div class='c pred'><span><b>P:</b> <b>A004 - PREDICTION</b></span></div><div class='c pred'><span><b>P:</b> Sept FOMC communications lean hawkish.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> Warsh's hawkish hike supports higher front end rates.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> Warsh's hawkish hike supports twist flattening of the UST curve.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> The USD is supported.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> Risk is challenged.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> The hawkish hike challenges the author's prior bias for lower belly rates.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> <b>A006 - VIEW</b></span></div></div>"]
