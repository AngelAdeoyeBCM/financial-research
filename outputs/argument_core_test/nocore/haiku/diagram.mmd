    A001["<div class='arg'><b>A001 · PREDICTION</b><div class='core pred'><span>The Fed hikes 25bp.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> Friday's CPI data all but lock in a rate hike this week.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> Chairman Warsh's Jackson Hole remarks have raised the cost of disappointing expectations significantly.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> Current market pricing has raised the cost of disappointing expectations significantly.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> <b>A002 - VIEW</b></span></div></div>"]
    A002["<div class='arg'><b>A002 · VIEW</b><div class='core view'><span>The Fed's choice is between a hike and a bond spike.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> The Fed risks a sharp and disorderly UST long end move.</span><b>[A]</b></div><div class='c fc'><span><b>P:</b> US 30Y rapidly tests 5.75%.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> <b>A003 - VIEW</b></span></div><div class='c sup'><span><b>CO:</b> The Fed does not hike with current pricing.</span><b>[HY]</b></div></div>"]
