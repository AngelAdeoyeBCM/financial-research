    A001["<div class='arg'><b>A001 · PREDICTION</b><div class='core pred'><span>Warsh delivers a hawkish hike.</span><b>[H]</b></div><div class='c pred'><span><b>P:</b> <b>A002 - PREDICTION</b></span></div><div class='c pred'><span><b>P:</b> <b>A008 - PREDICTION</b></span></div><div class='c pred'><span><b>P:</b> <b>A009 - PREDICTION</b></span></div><div class='c fc'><span><b>RI:</b> <b>A013 - FORECAST</b></span></div><div class='c view'><span><b>RI:</b> A bigger Bessent #quot;house#quot; is needed for the bond.</span><b>[A]</b></div><div class='c view'><span><b>IM:</b> Warsh's hawkish hike supports higher front end rates.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> <b>A010 - VIEW</b></span></div><div class='c view'><span><b>IM:</b> Risk is challenged.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> The hawkish hike challenges the author's prior bias for lower belly rates.</span><b>[H]</b></div><div class='c view'><span><b>IM:</b> <b>A012 - VIEW</b></span></div><div class='c view'><span><b>ALT:</b> <b>A014 - VIEW</b></span></div></div>"]
    A002["<div class='arg'><b>A002 · PREDICTION</b><div class='core pred'><span>The Fed hikes 25bp.</span><b>[H]</b></div><div class='c obs'><span><b>P:</b> <b>A003 - OBSERVATION</b></span></div><div class='c view'><span><b>P:</b> Friday's CPI data all but lock in a rate hike this week.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> Chairman Warsh's Jackson Hole remarks have raised the cost of disappointing expectations significantly.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> Current market pricing has raised the cost of disappointing expectations significantly.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> Friday's twist flattening of the Treasury curve provides further justification for a hike.</span><b>[H]</b></div><div class='c view'><span><b>P:</b> Rate pricing is firmly in the zone to support a hike.</span><b>[A]</b></div><div class='c view'><span><b>P:</b> <b>A004 - VIEW</b></span></div><div class='c view'><span><b>P:</b> Warsh understands bond risk with a Sept hold.</span><b>[H]</b></div><div class='c pred'><span><b>IM:</b> <b>A007 - PREDICTION</b></span></div></div>"]
