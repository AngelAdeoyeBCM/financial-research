    A014["<div class='arg'><b>A014 · VIEW</b><div class='core view'><span>Chair Warsh's aversion to forward guidance makes the bullish USD case challenging.</span><b>[H]</b></div></div>"]
    SC001["<div class='arg'><b>SC001 · Scenario · Fed holds despite current pricing</b><div class='c sup'><span><b>IF:</b> The Fed does not hike with current pricing.</span><b>[HY]</b></div><div class='c view'><span><b>THEN:</b> The Fed risks a sharp and disorderly UST long end move.</span><b>[A]</b></div><div class='c fc'><span><b>THEN:</b> US 30Y rapidly tests 5.75%.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> There is a material front end rate decline.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> There is a sharp twist steepening of the curve.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> Total hikes decline to 65-75bps.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> Hikes by end '26 decline to 30-35bps.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Twist steepening comes from a lower near term policy path and a perceived very high bar to hike.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Twist steepening comes from long end rates.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Long end rates reflect a higher inflation risk premium and a Warsh credibility discount.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Treasury buybacks prove futile to stop the UST long end move.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> The dollar depreciates swiftly and significantly.</span><b>[H]</b></div></div>"]
    SC002["<div class='arg'><b>SC002 · Scenario · Fed hikes 25bp at September FOMC</b><div class='c sup'><span><b>IF:</b> The Fed hikes.</span><b>[HY]</b></div><div class='c pred'><span><b>THEN:</b> The language around inflation in the FOMC statement is modified to rationalize the Sep hike.</span><b>[H]</b></div><div class='c pred'><span><b>THEN:</b> Chair Warsh fields questions about the policy path going forward.</span><b>[H]</b></div></div>"]
    SC003["<div class='arg'><b>SC003 · Scenario · Hawkish presser: inflation-impatient Warsh</b><div class='c sup'><span><b>IF:</b> Warsh continues to sound inflation impatient.</span><b>[HY]</b></div><div class='c sup'><span><b>IF:</b> Warsh suggests recent data does not imply an adequate disinflation trend.</span><b>[HY]</b></div><div class='c view'><span><b>THEN:</b> The market raises the hike peak.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> The market pulls forward hike timing.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> The hawkish presser sees 2Y rates rise 5-10bps.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> The hawkish presser sees 30Y rates lower by 5-10bps.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Bond yields are lower due to downside growth and inflation risk.</span><b>[A]</b></div><div class='c view'><span><b>THEN:</b> Bond yields are lower due to a more credible Fed return to orthodoxy.</span><b>[A]</b></div><div class='c view'><span><b>THEN:</b> The USD is supported.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Risk is challenged.</span><b>[H]</b></div></div>"]
    SC004["<div class='arg'><b>SC004 · Scenario · Dovish presser: hike with caution</b><div class='c sup'><span><b>IF:</b> Warsh implies an unpopular hike.</span><b>[HY]</b></div><div class='c sup'><span><b>IF:</b> Warsh implies few hikes to follow.</span><b>[HY]</b></div><div class='c sup'><span><b>IF:</b> Warsh implies improved signs in the inflation trend.</span><b>[HY]</b></div><div class='c view'><span><b>THEN:</b> The market reduces the hike peak.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> The market pushes out hike timing.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> The dovish presser sees 2Y rates lower by 5bps.</span><b>[H]</b></div><div class='c fc'><span><b>THEN:</b> The dovish presser sees 30Y rates higher by 5bps.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Bond yields are higher due to dovish Fed action and confusion about Warsh policy direction or reaction function.</span><b>[A]</b></div></div>"]
    SC005["<div class='arg'><b>SC005 · Scenario · Bullish USD: hike with hawkish signals</b><div class='c sup'><span><b>IF:</b> The SEP shows broadening support for additional hikes (relative to the June SEP).</span><b>[HY]</b></div><div class='c sup'><span><b>IF:</b> Growth and inflation forecasts are elevated even in the context of further hike guidance.</span><b>[HY]</b></div><div class='c sup'><span><b>IF:</b> Chair Warsh himself, intentionally or unintentionally, offers some indication that a more prolonged campaign is necessary to return inflation on the path to 2%.</span><b>[HY]</b></div><div class='c view'><span><b>THEN:</b> The bullish USD case sees increased market-implied likelihood that the Fed hikes at least 100bp.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> The bullish USD case sees increased market-implied likelihood that the Fed brings current expectations forward.</span><b>[H]</b></div></div>"]
    SC006["<div class='arg'><b>SC006 · Scenario · Bearish USD: hike with dovish messaging</b><div class='c sup'><span><b>IF:</b> The Fed hikes.</span><b>[HY]</b></div><div class='c view'><span><b>THEN:</b> The USD softens with dovish or non-committal language from Warsh.</span><b>[H]</b></div><div class='c view'><span><b>THEN:</b> Markets do not have the patience for anything that sounds like a #quot;one and done#quot; type event under the veil of #quot;no forward guidance#quot;.</span><b>[H]</b></div></div>"]

